# ── LEAVE ALL OF THESE UNSET TO RUN IN DEMO MODE ────────────────────────────
# Office Aux auto-detects Demo Mode vs Live Mode (see src/lib/mode.ts). Demo
# Mode needs zero configuration — just `npm install && npm run dev`.

# ── Supabase (Live Mode app data) ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Spotify (Live Mode playback — host account only) ────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a Redirect URI registered in your Spotify app settings.
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/auth/callback

# ── Admin ────────────────────────────────────────────────────────────────
# Shared passcode for the /admin panel. Required in both modes.
ADMIN_PASSCODE=change-me

# ── Optional ─────────────────────────────────────────────────────────────
# Force Demo Mode even if the above are set (useful for local UI work
# without touching real Spotify/Supabase).
OFFICE_AUX_FORCE_DEMO=false
